#!/bin/sh
BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "main" ]; then
  echo "--- Auto-deploy: pushing to GitHub ---"
  git push "https://hanaB149:$(gh auth token)@github.com/hanaB149/excavatio.git" main 2>&1
  echo "--- Auto-deploy: pushing to build.io ---"
  git push bld main 2>&1
fi
